---
import Base from '../layouts/Base.astro';
---

<Base
  title="Contact — Vineet Rawat & Associates"
  description="Get in touch with Vineet Rawat & Associates, Chartered Accountants."
  active="contact"
>
  <section class="page-banner">
    <div class="container">
      <h1>Get in Touch</h1>
      <p>Reach out for inquiries, consultations, or professional assistance.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="contact-cta">
        <a href="mailto:cavineet.rawat@vineetrawatassociates.com" class="contact-btn email">
          <span class="big-icon">&#9993;</span>
          <span>
            Email Us
            <small>cavineet.rawat@vineetrawatassociates.com</small>
          </span>
        </a>
        <a href="https://wa.me/918287372155" target="_blank" rel="noopener" class="contact-btn whatsapp">
          <span class="big-icon">&#128172;</span>
          <span>
            Chat on WhatsApp
            <small>+91 82873 72155</small>
          </span>
        </a>
        <a href="https://maps.app.goo.gl/CFRSXDWjMnC9VhZF9" target="_blank" rel="noopener" class="contact-btn location">
          <span class="big-icon">&#128205;</span>
          <span>
            Visit Our Office
            <small>Open in Google Maps</small>
          </span>
        </a>
      </div>
      <div class="office-block">
        <div class="office-address">
          <h3>Office Address</h3>
          <p>Office No. 307, 3rd Floor, Gupta Tower-1, G-Block Commercial Centre, PVR Complex, Vikaspuri, New Delhi 110018</p>
        </div>
        <a href="https://maps.app.goo.gl/CFRSXDWjMnC9VhZF9" target="_blank" rel="noopener" class="btn btn-navy">Open in Google Maps</a>
      </div>
      <div style="text-align:center; color: var(--muted); margin-top:24px;">
        <p><strong>Working Hours:</strong> Monday to Saturday &middot; 10:00 AM &ndash; 6:30 PM IST</p>
        <p>Service Regions: India &middot; UAE &middot; Australia &middot; UK</p>
      </div>
    </div>
  </section>
</Base>
